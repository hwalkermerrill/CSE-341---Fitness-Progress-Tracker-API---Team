### WORKOUTS ###
# Get all workouts
GET http://localhost:3000/workouts

# Get workout by ID
GET http://localhost:3000/workouts/{{workoutId}}

# Create a workout
POST http://localhost:3000/workouts
Content-Type: application/json

{
  "userId": "12345",
  "workoutType": "Running",
  "durationMinutes": 30,
  "date": "2026-07-17",
  "notes": "Felt good",
  "caloriesBurned": 250,
  "intensity": "Medium"
}

# Update a workout
PUT http://localhost:3000/workouts/{{workoutId}}
Content-Type: application/json

{
  "title": "Updated Workout Title",
  "duration": 45,
  "date": "2026-07-18",
  "exercises": ["Warmup", "Run", "Cooldown"]
}

# Delete a workout
DELETE http://localhost:3000/workouts/{{workoutId}}


### EXERCISE RECOMMENDATIONS ###
# Get all exercise recommendations
GET http://localhost:3000/exerciseRecommendations

# Get recommendation by ID
GET http://localhost:3000/exerciseRecommendations/{{recId}}

# Create a recommendation
POST http://localhost:3000/exerciseRecommendations
Content-Type: application/json

{
  "exerciseName": "Push-Up",
  "category": "Strength",
  "muscleGroup": "Chest",
  "difficulty": "Medium",
  "equipment": "None",
  "description": "A basic push-up exercise",
  "estimatedDuration": 5,
  "createdBy": "admin"
}

# Update a recommendation
PUT http://localhost:3000/exerciseRecommendations/{{recId}}
Content-Type: application/json

{
  "exerciseName": "Push-Up (Advanced)",
  "category": "Strength",
  "muscleGroup": "Chest",
  "difficulty": "Hard",
  "equipment": "None",
  "description": "Advanced push-up variation",
  "estimatedDuration": 10,
  "createdBy": "admin"
}

# Delete a recommendation
DELETE http://localhost:3000/exerciseRecommendations/{{recId}}
